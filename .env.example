# Never commit real values.
BETTER_AUTH_SECRET=generate-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Disabled by default. Set true only after mail, origins, and rate limits are reviewed.
ACCOUNTS_ENABLED=false

# Required before enabling accounts in a non-local environment. Resend-compatible HTTP API.
AUTH_EMAIL_FROM=Secret Share <noreply@example.com>
AUTH_EMAIL_API_KEY=
AUTH_EMAIL_ENDPOINT=https://api.resend.com/emails
