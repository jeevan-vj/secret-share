# Never commit real values.
BETTER_AUTH_SECRET=generate-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Production default is off until mail, trusted origins, and rate limits are reviewed.
ACCOUNTS_ENABLED=false

# none | memory | resend | webhook
# memory is for local/test only. Production enablement requires resend or webhook.
MAIL_PROVIDER=none
MAIL_FROM=
MAIL_API_KEY=
MAIL_WEBHOOK_URL=
