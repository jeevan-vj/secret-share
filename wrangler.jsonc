{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "secret-share",
  "main": "vinext/server/app-router-entry",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "once.iamjeevan.com",
      "custom_domain": true
    }
  ],
  "assets": { "not_found_handling": "none" },
  "vars": {
    "BETTER_AUTH_URL": "https://once.iamjeevan.com",
    "ACCOUNTS_ENABLED": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "secret-share",
      "database_id": "21674092-eae2-43ee-93ca-5041dc7e57b3",
      "migrations_dir": "drizzle"
    }
  ]
}
